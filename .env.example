# Chép file này thành .env và điền key thật. KHÔNG commit .env.
# Tên model KHÔNG đặt ở đây — nó nằm trong agents/llm.py (PROVIDER_PROFILES)
# theo yêu cầu mục 9.4 của đề. Ở đây chỉ có key và tên provider đang chọn.

# Chọn một trong: groq | cerebras | openrouter | mistral | ollama
LLM_PROVIDER=groq

# Chỉ cần điền key của provider đang dùng.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# CEREBRAS_API_KEY=csk-xxxxxxxxxxxxxxxxxxxx
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxx
# MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# ollama không cần key, chỉ cần `ollama serve` đang chạy

# Nới trần token/phút nếu provider cho phép nhiều hơn mặc định 6000.
# GROQ_TPM_LIMIT=6000
